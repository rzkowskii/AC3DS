# devkitARM cross toolchain. Set DEVKITPRO/DEVKITARM to an installed SDK.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR armv6k)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(NINTENDO_3DS TRUE)
if(NOT DEFINED DEVKITPRO)
    set(DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "devkitPro SDK root")
endif()
if(NOT DEVKITPRO)
    message(FATAL_ERROR "Set DEVKITPRO to an installed devkitPro SDK")
endif()
if(NOT DEFINED DEVKITARM)
    if(DEFINED ENV{DEVKITARM} AND NOT "$ENV{DEVKITARM}" STREQUAL "")
        set(DEVKITARM "$ENV{DEVKITARM}" CACHE PATH "devkitARM root")
    else()
        set(DEVKITARM "${DEVKITPRO}/devkitARM" CACHE PATH "devkitARM root")
    endif()
endif()
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DEVKITPRO DEVKITARM)
set(CMAKE_C_COMPILER "${DEVKITARM}/bin/arm-none-eabi-gcc")
set(CMAKE_CXX_COMPILER "${DEVKITARM}/bin/arm-none-eabi-g++")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_AR "${DEVKITARM}/bin/arm-none-eabi-ar")
set(CMAKE_RANLIB "${DEVKITARM}/bin/arm-none-eabi-ranlib")
if(NOT EXISTS "${CMAKE_C_COMPILER}" OR NOT EXISTS "${CMAKE_CXX_COMPILER}")
    message(FATAL_ERROR "DEVKITARM='${DEVKITARM}' must point to a complete devkitARM installation with the C and C++ compilers")
endif()
set(CMAKE_FIND_ROOT_PATH "${DEVKITPRO}/portlibs/3ds" "${DEVKITPRO}/libctru" "${DEVKITARM}/arm-none-eabi")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(_ac3ds_arch "-march=armv6k -mtune=mpcore -mfpu=vfp -mfloat-abi=hard -mtp=soft -marm")
set(CMAKE_C_FLAGS_INIT "${_ac3ds_arch} -mword-relocations -D__3DS__ -I\"${DEVKITPRO}/libctru/include\"")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_ASM_FLAGS_INIT "${_ac3ds_arch}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_ac3ds_arch} -specs=3dsx.specs -L\"${DEVKITPRO}/libctru/lib\"")
